# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / "publishable" key - safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key - server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# BotFather token for your bot
TELEGRAM_BOT_TOKEN=
# Username of the bot without the @, e.g. payalert_reminders_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Random secret you choose yourself; passed to Telegram's setWebhook call and
# checked against the X-Telegram-Bot-Api-Secret-Token header on every webhook
# request. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Random secret shared with Vercel Cron and the Telegram webhook URL.
# Generate with: openssl rand -hex 32
CRON_SECRET=
